---
import Layout from '../../layouts/Layout.astro';
import pseoData from '../../data/pseo_data.json';
import { SERVICES } from '../../data/site';

const services = SERVICES.map((service) => {
  const prices = pseoData.filter((d) => d.service.id === service.id).map((d) => d.economic_context.pricing.small);
  return { ...service, from: Math.min(...prices) };
});

---

<Layout title="Painting & Decorating Services and Prices | ApprovedDecorators" description="Four services – exterior house painting, commercial office decorating, wallpaper hanging and kitchen cabinet spray painting – with starting prices and 30 local areas.">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="text-4xl font-extrabold text-gray-900 tracking-tight mb-8">Our Services</h1>
    <p class="text-xl text-gray-600 mb-12 max-w-3xl">Explore our range of professional painting and decorating services available across the UK.</p>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {services.map(service => (
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-8 hover:shadow-md transition">
          <h2 class="text-2xl font-bold text-gray-900 mb-3">{service.name}</h2>
          <p class="text-gray-600 mb-3">{service.summary}</p>
          <p class="text-sm text-gray-500 mb-6">Estimated prices from <strong class="text-gray-900">£{service.from}</strong> · 30 areas</p>
          <a href={`/${service.id}`} class="text-blue-600 font-semibold hover:text-blue-800 flex items-center">
            {service.name}: prices & areas
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </a>
        </div>
      ))}
    </div>
  </div>
</Layout>
