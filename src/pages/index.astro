---
import Layout from '../layouts/Layout.astro';
---

<Layout title="ApprovedDecorators | UK's Leading Painting & Decorating Platform">
	<section class="bg-blue-600 py-20 text-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<h1 class="text-4xl md:text-6xl font-extrabold tracking-tight mb-6">Transform Your Space with the UK's Best Decorators</h1>
			<p class="text-xl md:text-2xl text-blue-100 mb-10 max-w-3xl mx-auto">We connect you with vetted, fully insured local painters and decorators. From London to Glasgow, get guaranteed quality.</p>
			<div class="flex flex-col sm:flex-row justify-center gap-4">
				<a href="/services" class="bg-white text-blue-600 px-8 py-4 rounded-md font-bold text-lg hover:bg-gray-50 transition">View Our Services</a>
				<a href="/areas" class="bg-blue-700 text-white border border-blue-500 px-8 py-4 rounded-md font-bold text-lg hover:bg-blue-800 transition">Find Local Decorators</a>
			</div>
		</div>
	</section>

	<section class="py-16 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<h2 class="text-3xl font-bold text-center text-gray-900 mb-12">Our Core Services</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
				<a href="/services" class="block group">
					<div class="bg-gray-50 rounded-lg p-6 border border-gray-200 hover:border-blue-500 hover:shadow-md transition h-full">
						<h3 class="text-xl font-bold text-gray-900 group-hover:text-blue-600 mb-3">Exterior Painting</h3>
						<p class="text-gray-600">Protect and beautify your home's exterior with our weather-resistant finishing.</p>
					</div>
				</a>
				<a href="/services" class="block group">
					<div class="bg-gray-50 rounded-lg p-6 border border-gray-200 hover:border-blue-500 hover:shadow-md transition h-full">
						<h3 class="text-xl font-bold text-gray-900 group-hover:text-blue-600 mb-3">Commercial Decorating</h3>
						<p class="text-gray-600">Professional out-of-hours service for offices, retail, and hospitality.</p>
					</div>
				</a>
				<a href="/services" class="block group">
					<div class="bg-gray-50 rounded-lg p-6 border border-gray-200 hover:border-blue-500 hover:shadow-md transition h-full">
						<h3 class="text-xl font-bold text-gray-900 group-hover:text-blue-600 mb-3">Wallpaper Hanging</h3>
						<p class="text-gray-600">Precision application for premium wallpapers and feature walls.</p>
					</div>
				</a>
				<a href="/services" class="block group">
					<div class="bg-gray-50 rounded-lg p-6 border border-gray-200 hover:border-blue-500 hover:shadow-md transition h-full">
						<h3 class="text-xl font-bold text-gray-900 group-hover:text-blue-600 mb-3">Cabinet Spraying</h3>
						<p class="text-gray-600">Factory-finish spray painting to transform your existing kitchen.</p>
					</div>
				</a>
			</div>
		</div>
	</section>

	<section class="py-16 bg-gray-50 border-t border-gray-200">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<h2 class="text-3xl font-bold text-gray-900 mb-6">Ready to get started?</h2>
			<p class="text-xl text-gray-600 mb-8 max-w-2xl mx-auto">Join thousands of happy customers across the UK who have transformed their properties with ApprovedDecorators.</p>
			<a href="/areas" class="inline-block bg-blue-600 text-white px-8 py-3 rounded-md font-semibold text-lg hover:bg-blue-700 transition">Find Decorators Near Me</a>
		</div>
	</section>
</Layout>
