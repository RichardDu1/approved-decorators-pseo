---
import Layout from '../layouts/Layout.astro';
import pseoData from '../data/pseo_data.json';

const siteUrl = 'https://approveddecorators.co.uk';

// Popular locations for quick crawlable shortcuts
const popularLondon = pseoData.filter(d => d.location.is_london && d.service.id === 'exterior-house-painting').slice(0, 8);
const popularCities = pseoData.filter(d => !d.location.is_london && d.service.id === 'exterior-house-painting').slice(0, 8);

const homeSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  "name": "ApprovedDecorators",
  "url": siteUrl,
  "description": "UK's leading network of verified painting and decorating specialists covering London and all major UK cities.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": `${siteUrl}/areas#{search_term_string}`,
    "query-input": "required name=search_term_string"
  }
};
---

<Layout 
  title="ApprovedDecorators | UK Painting & Decorating Contractors" 
  description="ApprovedDecorators connects UK homeowners and businesses with vetted painters & decorators. £2M insurance, 12-month guarantee & transparent pricing."
  canonical={siteUrl}
  schema={homeSchema}
>
	<!-- Hero Section with BLUF (Bottom Line Up Front) -->
	<section class="bg-gradient-to-br from-blue-700 via-blue-800 to-indigo-900 py-20 text-white relative overflow-hidden">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
			<div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-blue-500/20 border border-blue-400/30 rounded-full text-xs font-semibold uppercase tracking-wider mb-6 text-blue-200">
				<span>🏆 UK's Leading Vetted Painting Network</span>
				<span>•</span>
				<span>120+ Coverage Areas</span>
			</div>

			<h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight mb-6 leading-tight">
				Transform Your Space with Vetted UK Decorators
			</h1>

			<!-- BLUF: Bottom Line Up Front for Users and LLM Crawlers -->
			<p class="text-lg sm:text-xl text-blue-100 mb-8 max-w-3xl mx-auto leading-relaxed">
				<strong>The Bottom Line:</strong> Stop gambling on unverified tradesmen. ApprovedDecorators connects you directly with insured, 4-tier vetted local painters across Greater London and 15 major UK metropolitan hubs with a strict <strong>12-Month Guarantee</strong> and <strong>£2,000,000 Public Liability Insurance</strong>.
			</p>

			<div class="flex flex-col sm:flex-row justify-center gap-4 mb-12">
				<a href="/services" class="bg-white text-blue-800 px-8 py-4 rounded-lg font-bold text-lg hover:bg-gray-100 shadow-lg transition">
					Explore Our Services
				</a>
				<a href="/areas" class="bg-blue-600/80 border border-blue-400/60 text-white px-8 py-4 rounded-lg font-bold text-lg hover:bg-blue-600 shadow-lg transition">
					Find Local Decorators Near You
				</a>
			</div>

			<!-- Platform Fact Sheet (GEO Triplets) -->
			<div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto text-left">
				<div class="bg-white/10 backdrop-blur-md p-4 rounded-lg border border-white/10">
					<div class="text-xs text-blue-200 font-medium">Public Liability</div>
					<div class="text-lg font-bold text-white">£2,000,000</div>
					<div class="text-[11px] text-blue-200 mt-0.5">Verified policy on all jobs</div>
				</div>
				<div class="bg-white/10 backdrop-blur-md p-4 rounded-lg border border-white/10">
					<div class="text-xs text-blue-200 font-medium">Workmanship Warranty</div>
					<div class="text-lg font-bold text-white">12 Months</div>
					<div class="text-[11px] text-blue-200 mt-0.5">Written guarantee certificate</div>
				</div>
				<div class="bg-white/10 backdrop-blur-md p-4 rounded-lg border border-white/10">
					<div class="text-xs text-blue-200 font-medium">Network Footprint</div>
					<div class="text-lg font-bold text-white">30 Core UK Hubs</div>
					<div class="text-[11px] text-blue-200 mt-0.5">15 London Boroughs + 15 Cities</div>
				</div>
				<div class="bg-white/10 backdrop-blur-md p-4 rounded-lg border border-white/10">
					<div class="text-xs text-blue-200 font-medium">Client Satisfaction</div>
					<div class="text-lg font-bold text-white">4.9 / 5.0</div>
					<div class="text-[11px] text-blue-200 mt-0.5">Based on 240+ verified reviews</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Core Services Bento Grid -->
	<section class="py-18 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-14">
				<h2 class="text-3xl sm:text-4xl font-bold text-gray-900 tracking-tight">Specialised Decorating Services</h2>
				<p class="mt-3 text-base sm:text-lg text-gray-600 max-w-2xl mx-auto">
					Every service is delivered by vetted trade specialists trained in architectural preservation and contemporary finishes.
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
				<a href="/services" class="block group">
					<div class="bg-gray-50 rounded-xl p-7 border border-gray-200 hover:border-blue-500 hover:shadow-lg transition-all h-full flex flex-col justify-between">
						<div>
							<div class="w-10 h-10 bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center font-bold text-xl mb-4 group-hover:bg-blue-600 group-hover:text-white transition">🏡</div>
							<h3 class="text-xl font-bold text-gray-900 group-hover:text-blue-600 mb-2">Exterior House Painting</h3>
							<p class="text-sm text-gray-600 leading-relaxed">Weather-resistant masonry painting, timber sash window restoration, and heritage brick protection.</p>
						</div>
						<div class="mt-6 text-xs font-semibold text-blue-600 flex items-center gap-1">
							<span>Learn More & Pricing</span> <span>&rarr;</span>
						</div>
					</div>
				</a>

				<a href="/services" class="block group">
					<div class="bg-gray-50 rounded-xl p-7 border border-gray-200 hover:border-blue-500 hover:shadow-lg transition-all h-full flex flex-col justify-between">
						<div>
							<div class="w-10 h-10 bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center font-bold text-xl mb-4 group-hover:bg-blue-600 group-hover:text-white transition">🏢</div>
							<h3 class="text-xl font-bold text-gray-900 group-hover:text-blue-600 mb-2">Commercial Decorating</h3>
							<p class="text-sm text-gray-600 leading-relaxed">Fast-turnaround, out-of-hours painting for corporate offices, retail stores, and commercial venues.</p>
						</div>
						<div class="mt-6 text-xs font-semibold text-blue-600 flex items-center gap-1">
							<span>Learn More & Pricing</span> <span>&rarr;</span>
						</div>
					</div>
				</a>

				<a href="/services" class="block group">
					<div class="bg-gray-50 rounded-xl p-7 border border-gray-200 hover:border-blue-500 hover:shadow-lg transition-all h-full flex flex-col justify-between">
						<div>
							<div class="w-10 h-10 bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center font-bold text-xl mb-4 group-hover:bg-blue-600 group-hover:text-white transition">📜</div>
							<h3 class="text-xl font-bold text-gray-900 group-hover:text-blue-600 mb-2">Wallpaper Specialists</h3>
							<p class="text-sm text-gray-600 leading-relaxed">Precision installation of high-end designer papers, mural installations, and feature walls.</p>
						</div>
						<div class="mt-6 text-xs font-semibold text-blue-600 flex items-center gap-1">
							<span>Learn More & Pricing</span> <span>&rarr;</span>
						</div>
					</div>
				</a>

				<a href="/services" class="block group">
					<div class="bg-gray-50 rounded-xl p-7 border border-gray-200 hover:border-blue-500 hover:shadow-lg transition-all h-full flex flex-col justify-between">
						<div>
							<div class="w-10 h-10 bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center font-bold text-xl mb-4 group-hover:bg-blue-600 group-hover:text-white transition">🍳</div>
							<h3 class="text-xl font-bold text-gray-900 group-hover:text-blue-600 mb-2">Kitchen Cabinet Spraying</h3>
							<p class="text-sm text-gray-600 leading-relaxed">Factory-smooth, durable spray painting that transforms tired kitchens at 20% of renovation cost.</p>
						</div>
						<div class="mt-6 text-xs font-semibold text-blue-600 flex items-center gap-1">
							<span>Learn More & Pricing</span> <span>&rarr;</span>
						</div>
					</div>
				</a>
			</div>
		</div>
	</section>

	<!-- Local Coverage Internal Link Hub -->
	<section class="py-16 bg-gray-50 border-t border-gray-200">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-10">
				<h2 class="text-2xl sm:text-3xl font-bold text-gray-900">Popular Service Coverage Areas</h2>
				<p class="text-sm text-gray-600 mt-2">Browse local decorating contractors across high-demand UK territories:</p>
			</div>

			<div class="grid md:grid-cols-2 gap-8 mb-8">
				<div class="bg-white p-6 rounded-xl border border-gray-200">
					<h3 class="text-base font-bold text-gray-900 mb-3 flex items-center gap-2">
						<span>🏛️</span> London Boroughs
					</h3>
					<div class="flex flex-wrap gap-2">
						{popularLondon.map(item => (
							<a href={`/${item.service.id}/${item.location.id}`} class="inline-block bg-gray-50 hover:bg-blue-50 hover:text-blue-700 border border-gray-200 rounded px-3 py-1 text-xs text-gray-700 transition">
								{item.location.name}
							</a>
						))}
					</div>
					<div class="mt-4 pt-3 border-t border-gray-100 text-xs">
						<a href="/areas" class="text-blue-600 font-semibold hover:underline">View all 15 London Boroughs &rarr;</a>
					</div>
				</div>

				<div class="bg-white p-6 rounded-xl border border-gray-200">
					<h3 class="text-base font-bold text-gray-900 mb-3 flex items-center gap-2">
						<span>🏙️</span> Major UK Cities
					</h3>
					<div class="flex flex-wrap gap-2">
						{popularCities.map(item => (
							<a href={`/${item.service.id}/${item.location.id}`} class="inline-block bg-gray-50 hover:bg-blue-50 hover:text-blue-700 border border-gray-200 rounded px-3 py-1 text-xs text-gray-700 transition">
								{item.location.name}
							</a>
						))}
					</div>
					<div class="mt-4 pt-3 border-t border-gray-100 text-xs">
						<a href="/areas" class="text-blue-600 font-semibold hover:underline">View all 15 UK Cities &rarr;</a>
					</div>
				</div>
			</div>

			<div class="text-center">
				<a href="/areas" class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-lg shadow transition">
					<span>Browse Complete UK Areas Directory (120+ Pages)</span>
					<span>&rarr;</span>
				</a>
			</div>
		</div>
	</section>
</Layout>
