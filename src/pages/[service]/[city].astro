---
import Layout from '../../layouts/Layout.astro';
import FactSheet from '../../components/FactSheet.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import pseoData from '../../data/pseo_data.json';
import { SITE_URL, SITE_NAME, ORG_ID, PHONE_DISPLAY, PHONE_TEL, SERVICES, absoluteUrl } from '../../data/site';

export async function getStaticPaths() {
  return pseoData.map((data) => {
    return {
      params: {
        service: data.service.id,
        city: data.location.id
      },
      props: {
        data
      }
    };
  });
}

const { data } = Astro.props;
const { service, location, architecture_context, economic_context, proximity_context } = data;

const pageUrl = absoluteUrl(`/${service.id}/${location.id}`);
const serviceHubUrl = absoluteUrl(`/${service.id}`);
const postcodeAreas: string[] = location.postcode_areas;
const otherServices = SERVICES.filter((s) => s.id !== service.id);

const title = `${service.name} in ${location.name} – Prices from £${economic_context.pricing.small} | ${SITE_NAME}`;
const description = `${service.name} in ${location.name} (${postcodeAreas.join(', ')} postcodes): estimated prices £${economic_context.pricing.small}–£${economic_context.pricing.large}, typical 2–5 day jobs, £2M public liability insurance and a 12-month guarantee. Free quote.`;

// Schema 1: BreadcrumbList (mirrors the visible breadcrumb)
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": SITE_URL
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": service.name,
      "item": serviceHubUrl
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": `${service.name} in ${location.name}`,
      "item": pageUrl
    }
  ]
};

// Schema 2: Service offered by the single organisation in a specific area.
// (No LocalBusiness per page: there is no real local address to publish.)
const areaServed = location.is_london
  ? {
      "@type": "AdministrativeArea",
      "name": `London Borough of ${location.name}`,
      "containedInPlace": { "@type": "City", "name": "London" }
    }
  : { "@type": "City", "name": location.name };

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${pageUrl}#service`,
  "name": `${service.name} in ${location.name}`,
  "serviceType": service.name,
  "url": pageUrl,
  "description": description,
  "provider": { "@id": ORG_ID },
  "areaServed": areaServed,
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "GBP",
    "lowPrice": economic_context.pricing.small,
    "highPrice": economic_context.pricing.large,
    "offerCount": 3
  }
};

// Schema 3: FAQPage (same questions as the visible FAQ section)
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": economic_context.faqs.map((faq: { question: string; answer: string }) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};

const pageSchemas = [breadcrumbSchema, serviceSchema, faqSchema];
---

<Layout title={title} description={description} canonical={pageUrl} schema={pageSchemas} type="service" hasQuoteForm>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-gray-100 border-b border-gray-200 text-xs py-3" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center space-x-2 text-gray-500">
      <a href="/" class="hover:text-blue-600">Home</a>
      <span>/</span>
      <a href={`/${service.id}`} class="hover:text-blue-600">{service.name}</a>
      <span>/</span>
      <span class="text-gray-900 font-medium" aria-current="page">{service.name} in {location.name}</span>
    </div>
  </nav>

  <!-- Hero Section with BLUF (Bottom Line Up Front) -->
  <section class="bg-gradient-to-b from-blue-50 to-white py-14 md:py-20 border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-xs font-semibold uppercase tracking-wider mb-4">
        <span>📍 Vetted Local Specialists</span>
        <span>•</span>
        <span>{location.region} ({postcodeAreas.join(', ')})</span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-gray-900 tracking-tight mb-4">
        {service.name} in {location.name}
      </h1>

      <!-- BLUF Executive Summary for AI & Users -->
      <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto mb-6 leading-relaxed">
        <strong>In short:</strong> Looking for professional {service.name.toLowerCase()} in {location.name}? ApprovedDecorators connects you directly with insured, verified local craftsmen. Standard rates range from <strong>£{economic_context.pricing.small}</strong> to <strong>£{economic_context.pricing.large}</strong> with a strict <strong>12-Month Workmanship Guarantee</strong> and <strong>£2M Public Liability Insurance</strong>.
      </p>

      <div class="flex flex-col sm:flex-row justify-center gap-4 mb-8">
        <a href="#quote" class="bg-blue-600 text-white px-8 py-3.5 rounded-lg font-semibold text-lg hover:bg-blue-700 shadow-md transition">
          Get a Fast Free Quote
        </a>
        <a href={`tel:${PHONE_TEL}`} class="bg-white text-blue-600 border border-blue-600 px-8 py-3.5 rounded-lg font-semibold text-lg hover:bg-blue-50 transition flex items-center justify-center gap-2">
          <span>📞 Call {PHONE_DISPLAY}</span>
        </a>
      </div>

      <!-- Trust Badges Bar -->
      <div class="flex flex-wrap items-center justify-center gap-6 text-xs text-gray-600">
        <span class="flex items-center gap-1.5"><strong class="text-emerald-600">✓</strong> £2M Public Liability</span>
        <span class="flex items-center gap-1.5"><strong class="text-emerald-600">✓</strong> 12-Month Warranty</span>
        <span class="flex items-center gap-1.5"><strong class="text-emerald-600">✓</strong> Local Property Specialists</span>
        <span class="flex items-center gap-1.5"><strong class="text-emerald-600">✓</strong> 4.9/5 Client Rating</span>
      </div>
    </div>
  </section>

  <!-- GEO Fact Sheet Container -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <FactSheet 
      serviceName={service.name}
      locationName={location.name}
      region={location.region}
      isLondon={location.is_london}
      pricing={economic_context.pricing}
      architecturalSuitability={architecture_context.pain_points}
    />
  </section>

  <!-- Local Context & Architecture Pain Points -->
  <section class="py-14 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-12 gap-12 items-start">
        <div class="lg:col-span-7">
          <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-4">
            Specialist {service.name} Considerations in {location.name}
          </h2>
          <p class="text-base sm:text-lg text-gray-600 mb-6">
            Property decoration in {location.name} requires nuanced knowledge of regional building styles, local conservation standards, and moisture conditions. Our verified tradespeople are tailored specifically to resolve local challenges:
          </p>
          
          <div class="space-y-4 mb-8">
            {architecture_context.pain_points.map((point: string) => (
              <div class="flex items-start bg-blue-50/50 p-4 rounded-lg border border-blue-100">
                <div class="p-1 bg-blue-600 text-white rounded mr-3 shrink-0 mt-0.5">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <div>
                  <h3 class="text-sm font-semibold text-gray-900">Architecture Match</h3>
                  <p class="text-sm text-gray-700 mt-0.5">{point}</p>
                </div>
              </div>
            ))}
          </div>

          <h3 class="text-xl font-bold text-gray-900 mb-3">Our 4-Step Decorating Protocol</h3>
          <ol class="space-y-3 text-sm text-gray-600 list-decimal list-inside pl-1">
            <li><strong>Surface Preparation:</strong> Deep sanding, filling imperfections, and anti-mould primer application.</li>
            <li><strong>Material Selection:</strong> Commercial-grade low-VOC paints, breathable microporous masonry coats, or heritage pastes.</li>
            <li><strong>Flawless Application:</strong> Multi-coat coverage with precision cutting-in and airless spray technology where appropriate.</li>
            <li><strong>Final Inspection & Clean-up:</strong> Complete property walkthrough, clean work area, and 12-month certificate issuance.</li>
          </ol>
        </div>

        <!-- Fast Callback / Quote Form -->
        <div class="lg:col-span-5 mt-10 lg:mt-0">
          <QuoteForm serviceName={service.name} locationName={location.name} />
        </div>
      </div>
    </div>
  </section>

  <!-- Transparent Pricing Section -->
  <section class="bg-gray-50 py-16 border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900">Estimated Project Rates in {location.name}</h2>
        <p class="mt-3 text-base text-gray-600 max-w-2xl mx-auto">
          Transparent, competitive market pricing calibrated for {location.name} property standards. Materials and standard preparation included.
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch">
        <!-- Small Tier -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 flex flex-col justify-between">
          <div>
            <h3 class="text-xl font-bold text-gray-900 mb-1">Small Scope</h3>
            <p class="text-xs text-gray-500 mb-4">Single room, accent wall, or small facade</p>
            <div class="text-3xl font-extrabold text-blue-600 mb-6">From £{economic_context.pricing.small}</div>
            <ul class="text-sm space-y-3 mb-6 text-gray-600">
              <li class="flex items-center gap-2"><span class="text-emerald-500 font-bold">✓</span> Surface prep & minor filling</li>
              <li class="flex items-center gap-2"><span class="text-emerald-500 font-bold">✓</span> Premium quality paints included</li>
              <li class="flex items-center gap-2"><span class="text-emerald-500 font-bold">✓</span> 1-2 day turnaround</li>
            </ul>
          </div>
          <a href="#quote" class="block text-center py-2.5 px-4 bg-gray-100 hover:bg-gray-200 text-gray-800 font-semibold rounded-md text-sm transition">
            Book Small Project
          </a>
        </div>
        
        <!-- Medium Tier (Featured) -->
        <div class="bg-gradient-to-b from-blue-600 to-blue-700 rounded-xl shadow-md border border-blue-800 p-8 text-white flex flex-col justify-between transform md:-translate-y-2">
          <div>
            <div class="inline-block bg-blue-500 text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded-full mb-2">Most Popular</div>
            <h3 class="text-xl font-bold text-white mb-1">Medium Scope</h3>
            <p class="text-xs text-blue-100 mb-4">2-3 rooms, full kitchen cabinetry, or townhouse front</p>
            <div class="text-3xl font-extrabold text-white mb-6">From £{economic_context.pricing.medium}</div>
            <ul class="text-sm space-y-3 mb-6 text-blue-50">
              <li class="flex items-center gap-2"><span class="text-emerald-300 font-bold">✓</span> Comprehensive surface repair & sanding</li>
              <li class="flex items-center gap-2"><span class="text-emerald-300 font-bold">✓</span> High-durability coatings or specialist wallpaper</li>
              <li class="flex items-center gap-2"><span class="text-emerald-300 font-bold">✓</span> Priority scheduling & dedicated foreman</li>
              <li class="flex items-center gap-2"><span class="text-emerald-300 font-bold">✓</span> 12-Month Guarantee certificate</li>
            </ul>
          </div>
          <a href="#quote" class="block text-center py-2.5 px-4 bg-white hover:bg-gray-100 text-blue-700 font-bold rounded-md text-sm transition shadow">
            Book Medium Project
          </a>
        </div>
        
        <!-- Large Tier -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 flex flex-col justify-between">
          <div>
            <h3 class="text-xl font-bold text-gray-900 mb-1">Full Property / Commercial</h3>
            <p class="text-xs text-gray-500 mb-4">Whole house overhaul or commercial office space</p>
            <div class="text-3xl font-extrabold text-blue-600 mb-6">From £{economic_context.pricing.large}</div>
            <ul class="text-sm space-y-3 mb-6 text-gray-600">
              <li class="flex items-center gap-2"><span class="text-emerald-500 font-bold">✓</span> Full property scaffolding & masking</li>
              <li class="flex items-center gap-2"><span class="text-emerald-500 font-bold">✓</span> Specialist spray finishes & out-of-hours service</li>
              <li class="flex items-center gap-2"><span class="text-emerald-500 font-bold">✓</span> Dedicated project manager & milestone sign-offs</li>
            </ul>
          </div>
          <a href="#quote" class="block text-center py-2.5 px-4 bg-gray-100 hover:bg-gray-200 text-gray-800 font-semibold rounded-md text-sm transition">
            Book Large Project
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Localized FAQs (Schema.org Aligned) -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold text-gray-900">Frequently Asked Questions: {service.name} in {location.name}</h2>
        
      </div>

      <div class="space-y-6">
        {economic_context.faqs.map((faq: { question: string; answer: string }) => (
          <div class="bg-gray-50 p-6 rounded-lg border border-gray-200">
            <h3 class="text-base font-bold text-gray-900 mb-2">{faq.question}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Cross-linking & Programmatic Topic Clusters -->
  <section class="py-14 bg-gray-100 border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-10">
        <!-- Cluster 1: Cross-Service Internal Links in same City -->
        <div class="bg-white p-6 rounded-lg border border-gray-200">
          <h3 class="text-lg font-bold text-gray-900 mb-3 flex items-center gap-2">
            <span>🎨</span> Other Decorating Services in {location.name}
          </h3>
          <p class="text-xs text-gray-500 mb-4">Explore other approved trade specialisms available across {location.name}:</p>
          <ul class="space-y-2 text-sm">
            {otherServices.map((other) => (
              <li>
                <a href={`/${other.id}/${location.id}`} class="text-blue-600 hover:text-blue-800 font-medium hover:underline flex justify-between items-center">
                  <span>{other.name} in {location.name}</span>
                  <span class="text-xs text-gray-400">→</span>
                </a>
              </li>
            ))}
            <li class="pt-2 mt-2 border-t border-gray-100">
              <a href={`/${service.id}`} class="text-blue-600 hover:text-blue-800 font-semibold hover:underline">{service.name} in all 30 areas →</a>
            </li>
          </ul>
        </div>

        <!-- Cluster 2: Nearby Proximity Internal Links -->
        <div class="bg-white p-6 rounded-lg border border-gray-200">
          <h3 class="text-lg font-bold text-gray-900 mb-3 flex items-center gap-2">
            <span>📍</span> Nearest Other Areas We Cover
          </h3>
          <p class="text-xs text-gray-500 mb-4">The closest other {location.is_london ? 'London boroughs' : 'UK cities'} with {service.name.toLowerCase()} pages (approximate straight-line distance from {location.name}):</p>
          <div class="flex flex-wrap gap-2">
            {proximity_context.nearby_areas.map((area: { id: string; name: string; distance_miles: number }) => (
              <a 
                href={`/${service.id}/${area.id}`} 
                class="inline-block bg-gray-50 border border-gray-300 hover:border-blue-500 hover:bg-blue-50 hover:text-blue-700 rounded-md px-3 py-1.5 text-xs text-gray-700 font-medium transition"
              >
                {service.name} in {area.name} <span class="text-gray-400">(~{area.distance_miles} mi)</span>
              </a>
            ))}
          </div>
          <div class="mt-4 pt-3 border-t border-gray-100 text-xs">
            <a href="/areas" class="text-blue-600 hover:underline font-semibold">View all 30 areas we cover &rarr;</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
