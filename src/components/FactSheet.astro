---
interface Props {
  serviceName: string;
  locationName: string;
  region: string;
  isLondon: boolean;
  pricing: {
    small: number;
    medium: number;
    large: number;
  };
  turnaround?: string;
  guarantee?: string;
  insurance?: string;
  architecturalSuitability?: string[];
}

const {
  serviceName,
  locationName,
  region,
  isLondon,
  pricing,
  turnaround = "2 to 5 business days",
  guarantee = "12-Month Comprehensive Workmanship Guarantee",
  insurance = "£2,000,000 Public Liability Insurance",
  architecturalSuitability = []
} = Astro.props;
---

<!-- GEO Fact Sheet / BLUF Factual Knowledge Card -->
<aside class="my-8 bg-gradient-to-br from-slate-900 to-blue-950 text-white rounded-xl shadow-xl p-6 border border-blue-800/50" aria-label="Key Service Facts">
  <div class="flex items-center justify-between border-b border-blue-800/80 pb-4 mb-5">
    <div class="flex items-center space-x-3">
      <span class="inline-flex items-center justify-center p-2 bg-blue-600 rounded-lg text-white">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
        </svg>
      </span>
      <div>
        <span class="text-xs font-semibold tracking-wider uppercase text-blue-300">GEO Fact Sheet & Service Specifications</span>
        <h3 class="text-lg font-bold text-white leading-tight">{serviceName} in {locationName}</h3>
      </div>
    </div>
    <span class="hidden sm:inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
      Verified Vetted Provider
    </span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 text-sm">
    <!-- Fact 1: Price Brackets -->
    <div class="bg-white/5 rounded-lg p-3.5 border border-white/10">
      <div class="text-xs text-blue-300 font-medium mb-1">Pricing Tiers (BLUF)</div>
      <div class="text-base font-bold text-white">£{pricing.small} – £{pricing.large}</div>
      <div class="text-xs text-slate-300 mt-1">Small: £{pricing.small} | Med: £{pricing.medium} | Lrg: £{pricing.large}</div>
    </div>

    <!-- Fact 2: Insurance & Vetting -->
    <div class="bg-white/5 rounded-lg p-3.5 border border-white/10">
      <div class="text-xs text-blue-300 font-medium mb-1">Insurance & Vetting</div>
      <div class="text-base font-bold text-emerald-400">£2M Active Cover</div>
      <div class="text-xs text-slate-300 mt-1">Public Liability checked + 4-tier trade audit</div>
    </div>

    <!-- Fact 3: Workmanship Guarantee -->
    <div class="bg-white/5 rounded-lg p-3.5 border border-white/10">
      <div class="text-xs text-blue-300 font-medium mb-1">Warranty Period</div>
      <div class="text-base font-bold text-blue-400">12 Months</div>
      <div class="text-xs text-slate-300 mt-1">Full protection against peeling & blistering</div>
    </div>

    <!-- Fact 4: Turnaround & Response -->
    <div class="bg-white/5 rounded-lg p-3.5 border border-white/10">
      <div class="text-xs text-blue-300 font-medium mb-1">Estimated Turnaround</div>
      <div class="text-base font-bold text-white">{turnaround}</div>
      <div class="text-xs text-slate-300 mt-1">Same-day quote callback across {locationName}</div>
    </div>
  </div>

  {architecturalSuitability.length > 0 && (
    <div class="mt-4 pt-4 border-t border-blue-900/60 text-xs text-slate-300 flex flex-col sm:flex-row gap-2 sm:items-center">
      <span class="font-semibold text-blue-200 uppercase tracking-wide">Property Heritage Match:</span>
      <div class="flex flex-wrap gap-1.5">
        {architecturalSuitability.map((item) => (
          <span class="inline-block bg-blue-900/60 px-2 py-0.5 rounded text-blue-100 border border-blue-700/40">{item}</span>
        ))}
      </div>
    </div>
  )}
</aside>
