---
import { PHONE_DISPLAY, PHONE_TEL } from '../data/site';

interface Props {
  serviceName?: string;
  locationName?: string;
}

const { serviceName, locationName } = Astro.props;
const scope = serviceName && locationName
  ? `${serviceName.toLowerCase()} in ${locationName}`
  : 'your painting or decorating project';
---

<div class="bg-white p-7 rounded-xl shadow-lg border border-gray-200 scroll-mt-24" id="quote">
  <div class="flex items-center justify-between mb-4 gap-3">
    <h2 class="text-xl font-bold text-gray-900">Request a Free Quote</h2>
  </div>
  <p class="text-xs text-gray-500 mb-5">Ask for an estimate for {scope}. No obligation.</p>

  <form class="space-y-4" data-quote-form>
    <input type="hidden" name="service" value={serviceName ?? ''} />
    <div class="hidden" aria-hidden="true">
      <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
    </div>
    <div>
      <label for="quote-name" class="block text-xs font-semibold text-gray-700 mb-1">Your Full Name</label>
      <input type="text" id="quote-name" name="name" autocomplete="name" placeholder="e.g. David Smith" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none" required />
    </div>
    <div>
      <label for="quote-contact" class="block text-xs font-semibold text-gray-700 mb-1">Phone Number or Email</label>
      <input type="text" id="quote-contact" name="contact" autocomplete="email" placeholder="e.g. 07123 456789 or name@example.co.uk" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none" required />
    </div>
    <div>
      <label for="quote-location" class="block text-xs font-semibold text-gray-700 mb-1">Postcode / Location Area</label>
      <input type="text" id="quote-location" name="location" autocomplete="postal-code" value={locationName ?? ''} placeholder="e.g. NW1 or Manchester" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none" />
    </div>
    <div>
      <label for="quote-details" class="block text-xs font-semibold text-gray-700 mb-1">Project Scope & Timeline</label>
      <textarea id="quote-details" name="details" rows="3" placeholder="Tell us about the property, rooms, or surfaces to decorate..." class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none"></textarea>
    </div>
    <button type="submit" class="w-full py-3 px-4 rounded-md shadow text-sm font-bold text-white bg-blue-600 hover:bg-blue-700 transition disabled:opacity-60">
      Get My Free Estimate
    </button>
    <p class="text-sm rounded-md px-3 py-2 hidden" role="status" data-quote-status></p>
    <p class="text-[11px] text-gray-400 text-center">We only use your details to respond to this request. See our <a href="/privacy" class="underline">Privacy Policy</a>.</p>
  </form>
</div>

<script define:vars={{ phone: PHONE_DISPLAY, tel: PHONE_TEL }}>
  document.querySelectorAll('[data-quote-form]').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const status = form.querySelector('[data-quote-status]');
      const button = form.querySelector('button[type="submit"]');
      const show = (ok, html) => {
        status.innerHTML = html;
        status.className = 'text-sm rounded-md px-3 py-2 ' + (ok ? 'bg-emerald-50 text-emerald-800' : 'bg-amber-50 text-amber-900');
      };
      const data = Object.fromEntries(new FormData(form));
      data.page = location.pathname;
      button.disabled = true;
      try {
        const res = await fetch('/api/quote', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(data),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        show(true, 'Thank you — your request has been received. We will reply using the contact details you gave.');
        if (typeof gtag === 'function') gtag('event', 'generate_lead', { form: 'quote' });
      } catch {
        show(false, 'Sorry, your request could not be sent online. Please call us on <a class="underline font-semibold" href="tel:' + tel + '">' + phone + '</a>.');
      } finally {
        button.disabled = false;
      }
    });
  });
</script>
