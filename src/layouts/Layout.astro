---
import '../styles/global.css';
import { SITE_URL, SITE_NAME, ORG_ID, PHONE_DISPLAY, PHONE_TEL, PHONE_E164, SERVICES, absoluteUrl } from '../data/site';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: Record<string, any> | Array<Record<string, any>>;
  type?: 'website' | 'article' | 'service';
  /** Set when the page renders its own #quote form; otherwise header CTAs go to the homepage form. */
  hasQuoteForm?: boolean;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  schema,
  type = 'website',
  hasQuoteForm = false,
  noindex = false
} = Astro.props;

const canonicalURL = canonical || absoluteUrl(Astro.url.pathname);
const quoteHref = hasQuoteForm ? '#quote' : '/#quote';

// Optional measurement / verification, enabled via Cloudflare Pages environment variables.
const ga4Id = import.meta.env.PUBLIC_GA4_ID;
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION;
const bingVerification = import.meta.env.PUBLIC_BING_VERIFICATION;

const defaultOrgSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "HomeAndConstructionBusiness",
      "@id": ORG_ID,
      "name": SITE_NAME,
      "url": SITE_URL,
      "logo": `${SITE_URL}/favicon.svg`,
      "description": "The UK's leading vetted platform for professional painting and decorating contractors across London and major cities.",
      "telephone": PHONE_E164,
      "priceRange": "££",
      "areaServed": {
        "@type": "Country",
        "name": "United Kingdom"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "reviewCount": "248",
        "bestRating": "5",
        "worstRating": "1"
      },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Painting and Decorating Services",
        "itemListElement": SERVICES.map((service) => ({
          "@type": "Offer",
          "itemOffered": { "@type": "Service", "name": service.name, "url": `${SITE_URL}/${service.id}` }
        }))
      }
    },
    {
      "@type": "WebSite",
      "@id": `${SITE_URL}/#website`,
      "url": SITE_URL,
      "name": SITE_NAME,
      "inLanguage": "en-GB",
      "publisher": {
        "@id": ORG_ID
      }
    }
  ]
};

const customSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		{noindex && <meta name="robots" content="noindex, follow" />}
		{gscVerification && <meta name="google-site-verification" content={gscVerification} />}
		{bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<!-- Canonical & Alternate Links -->
		<link rel="canonical" href={canonicalURL} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="theme-color" content="#2563eb" />

		<!-- AI / LLM Context Discovery Links (GEO Standard) -->
		<link rel="help" type="text/plain" href="/llms.txt" title="LLMs.txt Context" />
		<link rel="alternate" type="text/plain" href="/llms-full.txt" title="LLMs-full.txt Full Context" />

		<title>{title}</title>

		<!-- Open Graph / Social SEO -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:type" content={type === 'service' ? 'website' : type} />
		<meta property="og:locale" content="en_GB" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />

		<!-- Global Structured Data (Schema.org) -->
		<script type="application/ld+json" set:html={JSON.stringify(defaultOrgSchema)} />

		<!-- Page-Specific Structured Data -->
		{customSchemas.map((s) => (
			<script type="application/ld+json" set:html={JSON.stringify(s)} />
		))}

		{cfBeaconToken && (
			<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}></script>
		)}
	</head>
	<body class="bg-gray-50 text-gray-900 font-sans antialiased min-h-screen flex flex-col">
		<header class="bg-white shadow-sm sticky top-0 z-50">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="flex justify-between items-center h-16 gap-4">
					<div class="flex-shrink-0">
						<a href="/" class="text-xl sm:text-2xl font-bold text-blue-600 tracking-tight flex items-center gap-2">
							<span class="inline-block w-3 h-3 rounded-full bg-blue-600"></span>
							{SITE_NAME}
						</a>
					</div>
					<nav class="hidden lg:flex space-x-8" aria-label="Main Navigation">
						<a href="/services" class="text-gray-600 hover:text-blue-600 font-medium">Services</a>
						<a href="/areas" class="text-gray-600 hover:text-blue-600 font-medium">Areas Covered</a>
						<a href="/reviews" class="text-gray-600 hover:text-blue-600 font-medium">Reviews</a>
						<a href="/about" class="text-gray-600 hover:text-blue-600 font-medium">About</a>
					</nav>
					<div class="hidden lg:flex items-center space-x-4">
						<a href={`tel:${PHONE_TEL}`} class="text-sm font-semibold text-gray-700 hover:text-blue-600 whitespace-nowrap">📞 {PHONE_DISPLAY}</a>
						<a href={quoteHref} class="bg-blue-600 text-white px-4 py-2 rounded-md font-medium hover:bg-blue-700 transition whitespace-nowrap">Get a Quote</a>
					</div>
					<div class="flex lg:hidden items-center gap-2">
						<a href={`tel:${PHONE_TEL}`} class="p-2 rounded-md border border-gray-200 text-gray-700" aria-label={`Call ${PHONE_DISPLAY}`}>📞</a>
						<details class="relative">
							<summary class="list-none cursor-pointer p-2 rounded-md border border-gray-200 text-gray-700 select-none" aria-label="Open menu">☰</summary>
							<nav class="absolute right-0 mt-2 w-56 bg-white border border-gray-200 rounded-lg shadow-lg py-2 flex flex-col" aria-label="Mobile Navigation">
								<a href="/services" class="px-4 py-2 text-gray-700 hover:bg-gray-50">Services</a>
								<a href="/areas" class="px-4 py-2 text-gray-700 hover:bg-gray-50">Areas Covered</a>
								<a href="/reviews" class="px-4 py-2 text-gray-700 hover:bg-gray-50">Reviews</a>
								<a href="/about" class="px-4 py-2 text-gray-700 hover:bg-gray-50">About</a>
								<a href={quoteHref} class="mx-4 mt-2 text-center bg-blue-600 text-white px-4 py-2 rounded-md font-medium">Get a Quote</a>
							</nav>
						</details>
					</div>
				</div>
			</div>
		</header>
		
		<main class="flex-grow">
			<slot />
		</main>

		<footer class="bg-gray-900 text-white py-12 mt-auto border-t border-gray-800">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="grid grid-cols-1 md:grid-cols-4 gap-8">
					<div>
						<h2 class="text-xl font-bold mb-4">{SITE_NAME}</h2>
						<p class="text-gray-400 text-sm mb-4">Transforming spaces across the United Kingdom with certified, vetted painting and decorating professionals.</p>
						<p class="text-xs text-gray-500">
							Machine Index: <a href="/llms.txt" class="text-blue-400 hover:underline">llms.txt</a> | <a href="/llms-full.txt" class="text-blue-400 hover:underline">llms-full.txt</a>
						</p>
					</div>
					<div>
						<h2 class="text-lg font-semibold mb-4 text-gray-200">Quick Links</h2>
						<ul class="space-y-2 text-gray-400 text-sm">
							<li><a href="/services" class="hover:text-white transition">All Services</a></li>
							{SERVICES.map((service) => (
								<li><a href={`/${service.id}`} class="hover:text-white transition">{service.name}</a></li>
							))}
							<li><a href="/areas" class="hover:text-white transition">Locations We Cover</a></li>
							<li><a href="/reviews" class="hover:text-white transition">Customer Reviews</a></li>
							<li><a href="/about" class="hover:text-white transition">About & Vetting</a></li>
						</ul>
					</div>
					<div>
						<h2 class="text-lg font-semibold mb-4 text-gray-200">Legal & Compliance</h2>
						<ul class="space-y-2 text-gray-400 text-sm">
							<li><a href="/privacy" class="hover:text-white transition">Privacy Policy (GDPR)</a></li>
							<li><a href="/terms" class="hover:text-white transition">Terms & 12M Guarantee</a></li>
							<li><a href="/sitemap-index.xml" class="hover:text-white transition">XML Sitemap</a></li>
						</ul>
					</div>
					<div>
						<h2 class="text-lg font-semibold mb-4 text-gray-200">Trust & Guarantees</h2>
						<div class="flex flex-col space-y-3 text-sm">
							<div class="flex items-center text-emerald-400">
								<svg class="w-5 h-5 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
								<span>£2M Public Liability Insurance</span>
							</div>
							<div class="flex items-center text-emerald-400">
								<svg class="w-5 h-5 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
								<span>12-Month Guarantee</span>
							</div>
							<div class="flex items-center text-emerald-400">
								<svg class="w-5 h-5 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
								<span>Fully Vetted Professionals</span>
							</div>
						</div>
					</div>
				</div>
				<div class="mt-8 pt-8 border-t border-gray-800 text-center text-gray-500 text-sm">
					&copy; {new Date().getFullYear()} {SITE_NAME}. All rights reserved. Registered UK Local Service Platform.
				</div>
			</div>
		</footer>
		
		<!-- Analytics consent: GA4 only loads after the visitor accepts (UK PECR). -->
		{ga4Id && (<>
			<div id="cookie-banner" class="fixed bottom-0 left-0 w-full bg-white border-t border-gray-200 p-4 shadow-lg z-50 flex-col sm:flex-row justify-between items-center gap-3" style="display:none">
				<p class="text-sm text-gray-600">We would like to use Google Analytics cookies to understand how this site is used. You can accept or decline.</p>
				<div class="flex gap-2 shrink-0">
					<button id="decline-cookies-btn" class="border border-gray-300 text-gray-700 px-4 py-2 rounded text-sm font-medium hover:bg-gray-50 transition">Decline</button>
					<button id="accept-cookies-btn" class="bg-blue-600 text-white px-4 py-2 rounded text-sm font-medium hover:bg-blue-700 transition">Accept</button>
				</div>
			</div>
			<script define:vars={{ ga4Id }}>
				const KEY = 'analytics_consent';
				const banner = document.getElementById('cookie-banner');
				const read = () => { try { return localStorage.getItem(KEY); } catch { return null; } };
				const write = (v) => { try { localStorage.setItem(KEY, v); } catch {} };
				const loadGa = () => {
					window.dataLayer = window.dataLayer || [];
					window.gtag = function () { window.dataLayer.push(arguments); };
					window.gtag('js', new Date());
					window.gtag('config', ga4Id);
					const tag = document.createElement('script');
					tag.async = true;
					tag.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(ga4Id);
					document.head.appendChild(tag);
				};
				const consent = read();
				if (consent === 'granted') loadGa();
				else if (consent !== 'denied' && banner) banner.style.display = 'flex';
				document.getElementById('accept-cookies-btn')?.addEventListener('click', () => {
					write('granted');
					banner.style.display = 'none';
					loadGa();
				});
				document.getElementById('decline-cookies-btn')?.addEventListener('click', () => {
					write('denied');
					banner.style.display = 'none';
				});
			</script>
		</>)}
	</body>
</html>
