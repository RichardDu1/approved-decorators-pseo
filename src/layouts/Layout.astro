---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  schema?: Record<string, any> | Array<Record<string, any>>;
  type?: 'website' | 'article' | 'service';
}

const { 
  title, 
  description = "Professional Painting and Decorating Services across the UK. £2M Public Liability Insurance & 12-Month Guarantee.",
  canonical,
  schema,
  type = 'website'
} = Astro.props;

const siteUrl = 'https://approveddecorators.co.uk';
const canonicalURL = canonical || new URL(Astro.url.pathname, siteUrl).toString();

const defaultOrgSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "HomeAndConstructionBusiness",
      "@id": `${siteUrl}/#organization`,
      "name": "ApprovedDecorators",
      "url": siteUrl,
      "logo": `${siteUrl}/favicon.svg`,
      "description": "The UK's leading vetted platform for professional painting and decorating contractors across London and major cities.",
      "telephone": "+44-800-123-4567",
      "priceRange": "££",
      "areaServed": {
        "@type": "Country",
        "name": "United Kingdom"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "reviewCount": "248",
        "bestRating": "5",
        "worstRating": "1"
      },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Painting and Decorating Services",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Exterior House Painting" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Commercial Office Decorators" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Premium Wallpaper Hanging" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Kitchen Cabinet Spray Painting" } }
        ]
      }
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": "ApprovedDecorators",
      "publisher": {
        "@id": `${siteUrl}/#organization`
      }
    }
  ]
};

const customSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<!-- Canonical & Alternate Links -->
		<link rel="canonical" href={canonicalURL} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

		<!-- AI / LLM Context Discovery Links (GEO Standard) -->
		<link rel="help" type="text/plain" href="/llms.txt" title="LLMs.txt Context" />
		<link rel="alternate" type="text/plain" href="/llms-full.txt" title="LLMs-full.txt Full Context" />

		<title>{title}</title>

		<!-- Open Graph / Social SEO -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:site_name" content="ApprovedDecorators" />
		<meta property="og:type" content={type === 'service' ? 'website' : type} />
		<meta property="og:locale" content="en_GB" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />

		<!-- Global Structured Data (Schema.org) -->
		<script type="application/ld+json" set:html={JSON.stringify(defaultOrgSchema)} />

		<!-- Page-Specific Structured Data -->
		{customSchemas.map((s) => (
			<script type="application/ld+json" set:html={JSON.stringify(s)} />
		))}
	</head>
	<body class="bg-gray-50 text-gray-900 font-sans antialiased min-h-screen flex flex-col">
		<header class="bg-white shadow-sm sticky top-0 z-50">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="flex justify-between items-center h-16">
					<div class="flex-shrink-0">
						<a href="/" class="text-2xl font-bold text-blue-600 tracking-tight flex items-center gap-2">
							<span class="inline-block w-3 h-3 rounded-full bg-blue-600"></span>
							ApprovedDecorators
						</a>
					</div>
					<nav class="hidden md:flex space-x-8" aria-label="Main Navigation">
						<a href="/services" class="text-gray-600 hover:text-blue-600 font-medium">Services</a>
						<a href="/areas" class="text-gray-600 hover:text-blue-600 font-medium">Areas Covered</a>
						<a href="/reviews" class="text-gray-600 hover:text-blue-600 font-medium">Reviews</a>
						<a href="/about" class="text-gray-600 hover:text-blue-600 font-medium">About</a>
					</nav>
					<div class="hidden md:flex items-center space-x-4">
						<a href="tel:08001234567" class="text-sm font-semibold text-gray-700 hover:text-blue-600">📞 0800 123 4567</a>
						<a href="#quote" class="bg-blue-600 text-white px-4 py-2 rounded-md font-medium hover:bg-blue-700 transition">Get a Quote</a>
					</div>
				</div>
			</div>
		</header>
		
		<main class="flex-grow">
			<slot />
		</main>

		<footer class="bg-gray-900 text-white py-12 mt-auto border-t border-gray-800">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="grid grid-cols-1 md:grid-cols-4 gap-8">
					<div>
						<h3 class="text-xl font-bold mb-4">ApprovedDecorators</h3>
						<p class="text-gray-400 text-sm mb-4">Transforming spaces across the United Kingdom with certified, vetted painting and decorating professionals.</p>
						<p class="text-xs text-gray-500">
							Machine Index: <a href="/llms.txt" class="text-blue-400 hover:underline">llms.txt</a> | <a href="/llms-full.txt" class="text-blue-400 hover:underline">llms-full.txt</a>
						</p>
					</div>
					<div>
						<h4 class="text-lg font-semibold mb-4 text-gray-200">Quick Links</h4>
						<ul class="space-y-2 text-gray-400 text-sm">
							<li><a href="/services" class="hover:text-white transition">All Services</a></li>
							<li><a href="/areas" class="hover:text-white transition">Locations We Cover</a></li>
							<li><a href="/reviews" class="hover:text-white transition">Customer Reviews</a></li>
							<li><a href="/about" class="hover:text-white transition">About & Vetting</a></li>
						</ul>
					</div>
					<div>
						<h4 class="text-lg font-semibold mb-4 text-gray-200">Legal & Compliance</h4>
						<ul class="space-y-2 text-gray-400 text-sm">
							<li><a href="/privacy" class="hover:text-white transition">Privacy Policy (GDPR)</a></li>
							<li><a href="/terms" class="hover:text-white transition">Terms & 12M Guarantee</a></li>
							<li><a href="/sitemap-index.xml" class="hover:text-white transition">XML Sitemap</a></li>
						</ul>
					</div>
					<div>
						<h4 class="text-lg font-semibold mb-4 text-gray-200">Trust & Guarantees</h4>
						<div class="flex flex-col space-y-3 text-sm">
							<div class="flex items-center text-emerald-400">
								<svg class="w-5 h-5 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
								<span>£2M Public Liability Insurance</span>
							</div>
							<div class="flex items-center text-emerald-400">
								<svg class="w-5 h-5 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
								<span>12-Month Guarantee</span>
							</div>
							<div class="flex items-center text-emerald-400">
								<svg class="w-5 h-5 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
								<span>Fully Vetted Professionals</span>
							</div>
						</div>
					</div>
				</div>
				<div class="mt-8 pt-8 border-t border-gray-800 text-center text-gray-500 text-sm">
					&copy; {new Date().getFullYear()} ApprovedDecorators. All rights reserved. Registered UK Local Service Platform.
				</div>
			</div>
		</footer>
		
		<!-- Cookie Banner -->
		<div id="cookie-banner" class="fixed bottom-0 left-0 w-full bg-white border-t border-gray-200 p-4 shadow-lg z-50 flex flex-col sm:flex-row justify-between items-center hidden">
			<p class="text-sm text-gray-600 mb-2 sm:mb-0">We use cookies to enhance your experience. By continuing to visit this site you agree to our use of cookies.</p>
			<button id="accept-cookies-btn" class="bg-blue-600 text-white px-4 py-2 rounded text-sm font-medium hover:bg-blue-700 transition">Accept</button>
		</div>
		<script>
			if (!localStorage.getItem('cookies_accepted')) {
				const banner = document.getElementById('cookie-banner');
				if (banner) banner.style.display = 'flex';
			}
			document.getElementById('accept-cookies-btn')?.addEventListener('click', () => {
				localStorage.setItem('cookies_accepted', 'true');
				const banner = document.getElementById('cookie-banner');
				if (banner) banner.style.display = 'none';
			});
		</script>
	</body>
</html>
